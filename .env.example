# Chave compartilhada que os clientes HTTP devem enviar no header
# "X-API-Key". Gere algo aleatório e longo (ex.: openssl rand -hex 32).
WHATSAPP_API_KEY=

# Porta onde este serviço escuta (só em 127.0.0.1 — exponha via túnel).
WHATSAPP_SERVICO_PORT=4000

# Só para desenvolvimento: permite webhook em http:// e em endereços locais
# (localhost/rede interna). Nunca ative na VPS.
WHATSAPP_WEBHOOK_PERMITIR_LOCAL=false
